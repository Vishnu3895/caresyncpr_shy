{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "caresyncdfshy"
		},
		"ds_binadls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ds_binadls'"
		},
		"ls_azuredb_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_azuredb'"
		},
		"ls_azuresqldb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresqldb'"
		},
		"ls_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_datalake'"
		},
		"ls_postgres_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_postgres'"
		},
		"ds_binadls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncstrshy.dfs.core.windows.net/"
		},
		"ls_azuredb_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1020-073203-ljnwbwd7"
		},
		"ls_azuresqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresyncshysr.database.windows.net"
		},
		"ls_azuresqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresyncshydb"
		},
		"ls_azuresqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "caresyncshydbsr"
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncstrshy.dfs.core.windows.net/"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresyncshykey.vault.azure.net/"
		},
		"ls_postgres_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-crimson-dawn-b4kihtvs-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"ls_postgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "caresyncdfshy_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ds_binadls_accountKey": {
						"value": "[parameters('ds_binadls_accountKey')]"
					},
					"ls_azuredb_accessToken": {
						"value": "[parameters('ls_azuredb_accessToken')]"
					},
					"ls_azuresqldb_password": {
						"value": "[parameters('ls_azuresqldb_password')]"
					},
					"ls_datalake_accountKey": {
						"value": "[parameters('ls_datalake_accountKey')]"
					},
					"ls_postgres_password": {
						"value": "[parameters('ls_postgres_password')]"
					},
					"ds_binadls_properties_typeProperties_url": {
						"value": "[parameters('ds_binadls_properties_typeProperties_url')]"
					},
					"ls_azuredb_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_azuredb_properties_typeProperties_existingClusterId')]"
					},
					"ls_azuresqldb_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_server')]"
					},
					"ls_azuresqldb_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_database')]"
					},
					"ls_azuresqldb_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_userName')]"
					},
					"ls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_datalake_properties_typeProperties_url')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_postgres_properties_typeProperties_server": {
						"value": "[parameters('ls_postgres_properties_typeProperties_server')]"
					},
					"ls_postgres_properties_typeProperties_database": {
						"value": "[parameters('ls_postgres_properties_typeProperties_database')]"
					},
					"ls_postgres_properties_typeProperties_username": {
						"value": "[parameters('ls_postgres_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}