{
	"name": "PL_SENDEMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read the Ctrl_audit_log",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id = '@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "header",
					"value": "Ingestion and Transformation process for caresync has been completed."
				}
			},
			{
				"name": "Body footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "footer",
					"value": {
						"value": "For any queries ,please contact on +91342325252",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Read the Ctrl_audit_log",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "count_success",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Body footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Body header",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('count_success').output.firstRow.count,0),'FAILURE','SUCCESS')} | CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "count_success",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) from ctrl.audit_log where adf_run_id ='@{pipeline().parameters.adf_run_id}' and status IN ('FAILURE','IN_PROGRESS')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Main body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "main",
					"value": {
						"value": "{\n  \"subject\":\"@{variables('subject')}\",\n  \"email_receipients\":\"@{pipeline().globalParameters.emailreceipients}\",\n  \"body_header\":\"@{variables('header')}\",\n  \"body_footer\":\"@{variables('footer')}\",\n  \"status_table\":@{activity('Read the Ctrl_audit_log').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Web1",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Main body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.URL",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('main')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "9eed78cc-f00a-4834-aecb-b29abde1893c"
			}
		},
		"variables": {
			"header": {
				"type": "String"
			},
			"footer": {
				"type": "String"
			},
			"subject": {
				"type": "String"
			},
			"test": {
				"type": "String"
			},
			"main": {
				"type": "String"
			}
		},
		"annotations": []
	}
}